# data file for the Fltk User Interface Designer (fluid)
version 1.0311
header_name {.h}
code_name {.cxx}
class UserInterface {open
} {
  Function {init()} {open
  } {
    Fl_Window main_window {
      label Flencoder open
      xywh {37 143 1280 720} type Double hide
    } {
      Fl_Group top_group {open
        xywh {0 0 1280 50} labeltype NO_LABEL
      } {}
      Fl_Group left_group {
        label {  Codec Classes} open
        xywh {0 50 192 670} box BORDER_BOX labelfont 14 align 21
      } {}
      Fl_Group middle_group {
        label {  Settings} open
        xywh {192 50 768 670} box BORDER_BOX labelfont 14 align 21
      } {}
      Fl_Group right_group {
        label {  Summary} open
        xywh {960 50 320 670} box BORDER_BOX labelfont 14 align 21
      } {}
    }
  }
}
